Lets builds set how often the interrupt handler runs (and the built-in profiler samples):
-DJS_INTERRUPT_COUNTER_INIT=1000 for fine-grained desktop profiles (PKR_PROFILE_RATE in build_linux.sh).

--- a/quickjs.c
+++ b/quickjs.c
@@ -553,7 +553,9 @@
 
 /* must be large enough to have a negligible runtime cost and small
    enough to call the interrupt callback often. */
+#ifndef JS_INTERRUPT_COUNTER_INIT /* PKR: settable for fine-grained profiling builds */
 #define JS_INTERRUPT_COUNTER_INIT 10000
+#endif
 
 struct JSContext {
     JSGCObjectHeader header; /* must come first */
