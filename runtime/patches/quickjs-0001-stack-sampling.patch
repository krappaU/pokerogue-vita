+/* Patched (pokerogue-vita): sampling profiler support. Writes the current JS call stack in
+   "collapsed stack" form, outermost frame first, frames separated by ';', each frame as
+   name@file:line:col of the function's definition. Returns the number of frames written.
+   Safe to call from the interrupt handler. */
+int JS_SampleStack(JSContext *ctx, char *buf, size_t size)
+{
+    JSRuntime *rt = ctx->rt;
+    JSStackFrame *sf;
+    JSStackFrame *frames[64];
+    int n = 0, i;
+    size_t len = 0;
+    for (sf = rt->current_stack_frame; sf != NULL && n < 64; sf = sf->prev_frame)
+        frames[n++] = sf;
+    if (size)
+        buf[0] = '\0';
+    for (i = n - 1; i >= 0 && len + 1 < size; i--) {
+        JSObject *p;
+        const char *name, *file = NULL, *base;
+        int line = 0, col = 0;
+        sf = frames[i];
+        if (JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+            continue;
+        p = JS_VALUE_GET_OBJ(sf->cur_func);
+        name = get_func_name(ctx, sf->cur_func);
+        if (js_class_has_bytecode(p->class_id)) {
+            JSFunctionBytecode *b = p->u.func.function_bytecode;
+            file = JS_AtomToCString(ctx, b->filename);
+            line = b->line_num;
+            col = b->col_num;
+        }
+        base = file ? strrchr(file, '/') : NULL;
+        base = base ? base + 1 : file;
+        len += snprintf(buf + len, size - len, "%s%s@%s:%d:%d", len ? ";" : "",
+                        name && name[0] ? name : "(anon)", base ? base : "native", line, col);
+        if (len >= size)
+            len = size - 1;
+        JS_FreeCString(ctx, name);
+        JS_FreeCString(ctx, file);
+    }
+    return n;
+}
+
