+/* PKR: whether ArraySpeciesCreate(obj) is certainly `new Array(len)` of this realm: obj is a plain
+   array with Array.prototype as its prototype and no own "constructor", Array.prototype.constructor
+   is this realm's Array, and Array[Symbol.species] is still the built-in getter (returns this).
+   Answers without the two property reads and the getter call (~0.3 us per splice/map/slice). */
+static bool js_array_species_is_default(JSContext *ctx, JSValueConst obj)
+{
+    JSObject *p, *proto, *ctor, *getter;
+    JSShapeProperty *prs;
+    JSProperty *pr;
+
+    if (JS_VALUE_GET_TAG(obj) != JS_TAG_OBJECT ||
+        JS_VALUE_GET_TAG(ctx->array_ctor) != JS_TAG_OBJECT ||
+        JS_VALUE_GET_TAG(ctx->class_proto[JS_CLASS_ARRAY]) != JS_TAG_OBJECT)
+        return false;
+    p = JS_VALUE_GET_OBJ(obj);
+    proto = JS_VALUE_GET_OBJ(ctx->class_proto[JS_CLASS_ARRAY]);
+    ctor = JS_VALUE_GET_OBJ(ctx->array_ctor);
+    if (p->class_id != JS_CLASS_ARRAY || p->shape->proto != proto)
+        return false;
+    if (find_own_property(&pr, p, JS_ATOM_constructor))
+        return false;
+    prs = find_own_property(&pr, proto, JS_ATOM_constructor);
+    if (!prs || (prs->flags & JS_PROP_TMASK) != JS_PROP_NORMAL ||
+        JS_VALUE_GET_TAG(pr->u.value) != JS_TAG_OBJECT || JS_VALUE_GET_OBJ(pr->u.value) != ctor)
+        return false;
+    prs = find_own_property(&pr, ctor, JS_ATOM_Symbol_species);
+    if (!prs || (prs->flags & JS_PROP_TMASK) != JS_PROP_GETSET)
+        return false;
+    getter = pr->u.getset.getter;
+    JSCFunctionType ft = { .getter = js_get_this };
+    return getter && getter->class_id == JS_CLASS_C_FUNCTION &&
+           getter->u.cfunc.c_function.generic == ft.generic;
+}
+
 static JSValue JS_ArraySpeciesCreate(JSContext *ctx, JSValueConst obj,
                                      JSValueConst len_val)
 {
