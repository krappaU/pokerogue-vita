# SPDX-License-Identifier: AGPL-3.0-only
# Copy to .env (ignored by git) next to compose.yaml.
# Upload key, also in the console's config.txt as devkey=. Make one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(16))'
DEVSERVER_KEY=
# Cloudflare Zero Trust -> Networks -> Tunnels -> Create (cloudflared): the token from its install
# command. Give the tunnel a public hostname with the service http://devserver:8765
TUNNEL_TOKEN=
# Where the logs are kept (the old server's ~/pokerogue-devserver works: its logs are imported).
DEVSERVER_DATA=./data
# Owner of that folder, so the container can write to it (id -u, id -g).
DEVSERVER_UID=1000
DEVSERVER_GID=1000
